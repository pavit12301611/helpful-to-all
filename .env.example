# ---------------------------------------------------------------------------
# OpenHub environment
#
# Copy this file to `.env` and adjust. Only AUTH_SECRET is strictly required in
# production; everything else has a working default for local development.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./prisma/dev.db"
OPENHUB_DB="sqlite"
# PostgreSQL (recommended for anything public):
# DATABASE_URL="postgresql://openhub:openhub@localhost:5432/openhub?schema=public"
# OPENHUB_DB="postgresql"

# Security ------------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL, used for invite and notification links.
APP_URL="http://localhost:3000"
# Session lifetime in days (1-365).
SESSION_TTL_DAYS="30"

# Email (optional) ----------------------------------------------------------
# console = log to the server console (default, no external service needed)
# smtp    = any SMTP server through SMTP_URL
# resend  = Resend API through RESEND_API_KEY
EMAIL_PROVIDER="console"
# SMTP_URL="smtp://user:password@localhost:1025"
# RESEND_API_KEY=""
EMAIL_FROM="OpenHub <no-reply@openhub.local>"

# File storage (optional) ---------------------------------------------------
# local = files are written to UPLOAD_DIR (default)
STORAGE_PROVIDER="local"
UPLOAD_DIR="storage/uploads"

# Maps (optional) -----------------------------------------------------------
# openstreetmap = free embeds and links, no API key required (default)
# none          = hide map embeds entirely
MAP_PROVIDER="openstreetmap"

# External rates for the currency converter utility (optional).
# Without a key the converter works offline with a small built-in table.
# CURRENCY_API_KEY=""

# Rate limiting (optional) --------------------------------------------------
# Redis makes the limiter shared across processes. Without it the in-memory
# limiter is used, which is fine for a single-process deployment.
# REDIS_URL="redis://localhost:6379"
# RATE_LIMIT_MAX="60"
# RATE_LIMIT_WINDOW_SECONDS="60"

# Hardening -----------------------------------------------------------------
# Allow the app to be embedded in an iframe (Arena/preview environments).
# Leave unset in production so X-Frame-Options: DENY is sent.
# ALLOW_EMBED="true"
# Send HSTS headers even outside production (only behind HTTPS).
# ENABLE_HSTS="false"

# Seed ----------------------------------------------------------------------
# Password given to the demo accounts created by `npm run db:seed`.
# Change it if your instance is reachable from the internet.
SEED_PASSWORD="OpenHub!2345"
